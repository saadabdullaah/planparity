{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planparity.dev/schemas/report-v1.json",
  "title": "PlanParity report v1",
  "description": "Sanitized PlanParity state, plan, comparison, or rehearsal result.",
  "oneOf": [
    { "$ref": "#/$defs/inspectionResult" },
    { "$ref": "#/$defs/stateSnapshot" },
    { "$ref": "#/$defs/planResult" },
    { "$ref": "#/$defs/stateComparison" },
    { "$ref": "#/$defs/rehearsalResult" }
  ],
  "$defs": {
    "schemaVersion": { "const": "planparity/v1" },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "version"],
      "properties": {
        "kind": { "enum": ["terraform", "opentofu"] },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "platform": { "type": "string" }
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type_fingerprint", "keys", "sensitive_paths", "unknown_paths"],
      "properties": {
        "type_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "keys": { "type": "array", "items": { "type": "string" } },
        "sensitive_paths": { "type": "array", "items": { "type": "string" } },
        "unknown_paths": { "type": "array", "items": { "type": "string" } }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "mode", "resource_type", "resource_name", "provider_address", "schema_version", "status", "dependencies", "structure"],
      "properties": {
        "address": { "type": "string", "minLength": 1 },
        "module_address": { "type": "string" },
        "mode": { "enum": ["managed", "data"] },
        "resource_type": { "type": "string" },
        "resource_name": { "type": "string" },
        "instance_key": { "type": "string" },
        "provider_address": { "type": "string" },
        "schema_version": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["NORMAL", "TAINTED", "DEPOSED", "UNKNOWN"] },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "structure": { "$ref": "#/$defs/structure" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "severity", "verification", "confidence", "title", "explanation", "evidence", "recommendation"],
      "properties": {
        "id": { "type": "string", "pattern": "^PP-[A-Z]{4}-[0-9]{3}$" },
        "category": { "enum": ["COMPATIBILITY", "DESTRUCTIVE_CHANGE", "RESOURCE_IDENTITY", "PROVIDER_SCHEMA", "ENGINE_DIFFERENCE", "STATE_INTEGRITY", "SAFETY_LIMITATION"] },
        "severity": { "enum": ["INFO", "WARNING", "HIGH", "CRITICAL", "UNKNOWN"] },
        "verification": { "enum": ["VERIFIED", "INFERRED", "UNVERIFIED", "UNSUPPORTED", "FAILED"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "address": { "type": "string" },
        "title": { "type": "string" },
        "explanation": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "message"],
            "properties": { "kind": { "type": "string" }, "message": { "type": "string" } }
          }
        },
        "recommendation": { "type": "string" }
      }
    },
    "stateSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "format_version", "engine", "resources", "providers", "modules", "outputs", "source_hash"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "format_version": { "type": "string" },
        "engine": { "$ref": "#/$defs/engine" },
        "lineage": { "type": "string" },
        "serial": { "type": "integer", "minimum": 0 },
        "resources": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
        "providers": { "type": "array" },
        "modules": { "type": "array" },
        "outputs": { "type": "array" },
        "source_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "inspectionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "snapshot", "findings"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "snapshot": { "$ref": "#/$defs/stateSnapshot" },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }
      }
    },
    "planAction": { "enum": ["NO_OP", "CREATE", "READ", "UPDATE", "DELETE", "REPLACE", "UNKNOWN"] },
    "planChange": {
      "type": "object",
      "required": ["address", "resource_type", "provider", "actions", "replacement", "changed_paths", "unknown_paths"],
      "properties": {
        "address": { "type": "string" },
        "resource_type": { "type": "string" },
        "provider": { "type": "string" },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/planAction" } },
        "replacement": { "type": "boolean" },
        "changed_paths": { "type": "array", "items": { "type": "string" } },
        "unknown_paths": { "type": "array", "items": { "type": "string" } }
      }
    },
    "planSummary": {
      "type": "object",
      "required": ["creates", "reads", "updates", "deletes", "replacements", "no_ops", "unknown"],
      "properties": {
        "creates": { "type": "integer", "minimum": 0 },
        "reads": { "type": "integer", "minimum": 0 },
        "updates": { "type": "integer", "minimum": 0 },
        "deletes": { "type": "integer", "minimum": 0 },
        "replacements": { "type": "integer", "minimum": 0 },
        "no_ops": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 }
      }
    },
    "planResult": {
      "type": "object",
      "required": ["schema_version", "engine", "changes", "diagnostics", "summary", "source_hash"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "engine": { "$ref": "#/$defs/engine" },
        "changes": { "type": "array", "items": { "$ref": "#/$defs/planChange" } },
        "diagnostics": { "type": "array" },
        "summary": { "$ref": "#/$defs/planSummary" },
        "source_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "stateComparison": {
      "type": "object",
      "required": ["schema_version", "before_hash", "after_hash", "added", "removed", "changed", "probable_moves", "provider_changes", "findings", "summary"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "before_hash": { "type": "string" },
        "after_hash": { "type": "string" },
        "added": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
        "removed": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
        "changed": { "type": "array" },
        "probable_moves": { "type": "array" },
        "provider_changes": { "type": "array" },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "summary": { "type": "object" }
      }
    },
    "rehearsalResult": {
      "type": "object",
      "required": ["schema_version", "kind", "execution_mode", "schema_differences", "checks", "findings", "limitations"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "kind": { "enum": ["PLAN", "UPGRADE", "MIGRATE"] },
        "execution_mode": { "const": "LOCAL-RESTRICTED" },
        "baseline": { "$ref": "#/$defs/planResult" },
        "candidate": { "$ref": "#/$defs/planResult" },
        "comparison": { "type": "object" },
        "baseline_schemas": { "type": "object" },
        "candidate_schemas": { "type": "object" },
        "schema_differences": { "type": "array" },
        "checks": { "type": "array" },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "limitations": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
